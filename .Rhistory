lm_first_fit8,
lm_poly_fit8,
lm_third_fit8,
#  remove_fit8,
#  lagp_removed_fit8,
#  xgb_removed_fit8,
lm_first_removed_fit8,
lm_poly_removed_fit8,
lm_third_removed_fit8)
all_summary8$summary_long
all_summary8$summary_wide
getwd()
